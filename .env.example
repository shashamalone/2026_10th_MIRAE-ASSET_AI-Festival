# .env.example — 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 .gitignore 대상이며 절대 커밋하지 않는다.
#   cp .env.example .env
# 로딩: python-dotenv의 load_dotenv()가 src/agent/get_clova.py, src/agent/utils.py에서 호출된다.
# 표기: [필수]는 없으면 해당 경로가 동작하지 않고, [선택]은 주석의 기본값으로 동작한다.


# =======================================
# HyperCLOVA X — 의도 분석·답변 생성·임베딩
# =======================================
# [필수] NCP CLOVA Studio API 키. 대회 규칙상 의도 분석과 답변 생성은 이 모델만 사용한다.
#        코드는 CLOVASTUDIO_API_KEY → CLOVA_API_KEY → clova 순으로 찾는다(src/agent/get_clova.py).
CLOVA_API_KEY=

# [선택] 임베딩 모델명. 기본값 bge-m3 (1024차원). VectorDB 적재 시 사용한 모델과 반드시 일치시킨다.
CLOVA_EMBEDDING_MODEL=bge-m3


# =======================================
# RDB — 원격 SQL API (src/agent/utils.py::run_sql)
# =======================================
# [선택]  POST /db/sql에 text/plain으로 쿼리를 보낸다.
RDB_API_BASE_URL=http://40.82.145.44:8000

# [선택] 요청 타임아웃 초. 기본값 30.
RDB_API_TIMEOUT=30

# [선택] Bearer 토큰. 현재 API는 인증을 요구하지 않으므로 비워 둔다.
#        주의: 한글 등 non-latin-1 문자를 넣으면 HTTP 헤더 인코딩 단계에서 모든 RDB 호출이 실패한다.
# RDB_API_KEY=


# =======================================
# PostgreSQL / pgvector — VectorDB 직접 연결
# =======================================
# DATABASE_URL을 채우면 아래 PG* 값보다 우선한다. 둘 중 한 방식만 쓰면 된다.
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>

# [선택] 기본값 127.0.0.1
PGHOST=
# [선택] 기본값 5432
PGPORT=5432
# [선택] 기본값 postgres
PGDATABASE=
# [선택] 기본값 agent_reader (적재 스크립트 src/kb/build_data_platform.py는 agent_admin)
PGUSER=
# [필수] 원격 DB를 쓰는 경우. 로컬 trust 인증이면 비워 둔다.
PGPASSWORD=

# [선택] 벡터 스키마명. 기본값 vec. 청크 테이블은 vec.document_chunk.
VECTOR_SCHEMA=vec

# [선택] 연결·조회 타임아웃 초. 기본값 3. 응답 15초 목표 때문에 짧게 유지한다.
VECTOR_DB_TIMEOUT=3


# =======================================
# GraphDB — Oxigraph (src/infrastructure/graph_db/client.py)
# =======================================
# 3단계 폴백 순서대로 탐색한다. 하나만 채워도 동작한다.

# 1순위 [선택] 외부에서 마운트한 읽기 전용 snapshot 경로
# OXIGRAPH_REMOTE_STORE_PATH=

# 2순위 [선택] 로컬 snapshot 디렉터리 경로. OXIGRAPH_STORE_PATH도 같은 자리에서 인식된다.
OXIGRAPH_LOCAL_STORE_PATH=

# 3순위 [선택] 원격 SPARQL endpoint URL. OXIGRAPH_ENDPOINT도 같은 자리에서 인식된다.
OXIGRAPH_FALLBACK_ENDPOINT=

# [선택] SPARQL 타임아웃 초.
OXIGRAPH_TIMEOUT=60


# =======================================
# Azure OpenAI — 웹서치 실험용 (보류 상태, 현재 파이프라인 미사용)
# 대회 규칙상 의도 분석·답변 생성에는 쓸 수 없다.
# =======================================
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=




# =======================================
# 외부 데이터 수집 — 온톨로지·enriched 산출물 재생성 시에만 필요
# 런타임 질의 응답에는 쓰이지 않는다. 수집 데이터는 as_of <= 2026-08-24를 지켜야 한다.
# =======================================


