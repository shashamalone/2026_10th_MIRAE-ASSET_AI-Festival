@prefix fp:      <http://mafest.ai/product#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

################################################################################
# fp-etf-kr — 국내 ETF·ETN (PREF01N001, 1,734종 = ETF 1,202 / ETN 532)
#
# ETF와 ETN의 분리
#   fp-common에서 fp:ETN owl:disjointWith fp:ETF로 선언했다. 한 파일에 혼재하므로
#   pd_grp_no로 분리해 적재하지 않으면 'ETF 몇 개' 류 집계가 44% 부풀려진다.
#   ETN은 발행 증권사의 채무증권이라 **편입종목·NAV·총보수 개념이 없어**
#   fp:hasHolding의 domain에서 제외되어 있다(fp-common 참조).
#
# Q35 도메인 위반 판정
#   fp:issuedBy의 domain은 fp:Bond 하나이고 fp:ETF는 fp:Bond와 disjoint다.
#   따라서 ETF를 발행 주체로 놓는 질의는 형식적으로 도메인 위반이 되어 ABSTAIN된다.
#   ETF의 '발행'을 묻는 질의는 fp:managedBy(운용사)로 유도한다.
#
# 데이터 실태 (온톨로지에서 뺀 컬럼의 근거)
#   - 괴리율 du_diff_rt·추적오차율 du_chas_errt: 전 종목 0.00 미계산 → **제외**
#   - 배당 3컬럼(pd_dvid_cycl 전량 결측, pd_divd_amt_pshr·pd_dvid_yield 전량 0) → **제외**
#     배당·분배금 질의는 현재 데이터로 답변 불가다.
#   - 실시간·시세성 컬럼(du_clpr·du_bpr·du_lpr·ru_mkt_* 등) → **제외**
#     du_lpr은 스키마 한글 설명과 통상 의미가 충돌해 시가 질의에 쓰지 않는다.
#   - 상수 컬럼(거래소·시장·통화·SPAC 등) → **제외**
#   위 컬럼을 온톨로지에 올리면 "값이 있다"는 잘못된 신호가 된다.
#
# 기준일: 시세·주간 모두 2026-06-15(du_upt_dt·wu_upt_dt 상수).
################################################################################

<http://mafest.ai/ontology/fp-etf-kr> a owl:Ontology ;
    owl:imports <http://mafest.ai/ontology/fp-common> ;
    rdfs:label "국내 ETF·ETN 온톨로지"@ko, "Korean Domestic ETF/ETN Ontology"@en ;
    rdfs:comment "국내 ETF·ETN 마스터(PREF01N001)와 LSEG 보강 테이블 기반 스키마. ETF/ETN 분리, 총보수 보완 경로, 레버리지·연금·판매 축, 테마 개체 176종을 정의한다."@ko ;
    dcterms:source "PREF01N001_etf_kr_master_20260824.csv, data/enriched/etf_kr_enriched.csv, data/relations/etf_theme.csv" .

################################################################################
# 1. 분류축 클래스 — 주최측 axis_* 라벨 7종
#    assetType·region·strategy·replicationMethod는 fp-common의 공통 개체를 재사용하고,
#    ETF 고유 축(leverageType·underlyingScope·distributionType)만 여기서 선언한다.
################################################################################

fp:LeverageType a owl:Class ;
    rdfs:label "레버리지 유형"@ko, "Leverage Type"@en ;
    rdfs:comment "주최측 axis_leverageType. 원본 cu_lev_fector(배수, 음수=인버스)에서 완전히 재현된다. 레버리지·인버스 질의의 유일한 정형축이다."@ko .

fp:UnderlyingScope a owl:Class ;
    rdfs:label "기초자산 범위"@ko, "Underlying Scope"@en ;
    rdfs:comment "주최측 axis_underlyingScope(시장대표/섹터·테마/개별종목). **현재 데이터로 값을 채울 수 없다** — 기초지수 cu_base_index가 ETF 기준 95.2% 결측이고 pd_sect_nm은 전량 결측이다. LSEG 테마(fp:relatedToTheme)는 섹터·테마 여부의 부분 신호일 뿐 시장대표/개별종목 구분을 대체하지 못한다. 클래스·속성은 선언하되 값을 부여하지 않는다."@ko .

fp:DistributionType a owl:Class ;
    rdfs:label "분배 유형"@ko, "Distribution Type"@en ;
    rdfs:comment "주최측 axis_distributionType(분배형/TR형). **배당 관련 3컬럼이 전량 무효**라 원본에서 재현 불가하며, 상품명의 'TR' 토큰 파싱으로만 부분 추정된다. 추정값은 근거가 약하므로 답변 시 추정임을 명시한다."@ko .

fp:ManagementStrategy a owl:Class ;
    rdfs:label "운용전략"@ko, "Management Strategy"@en ;
    rdfs:comment "주최측 axis_strategy(패시브/액티브). 원본 cu_strtegy 한 컬럼이 이 축과 복제방식(fp:ReplicationMethod) 두 축을 동시에 공급한다 — '액티브'는 Active, '실물복제'·'합성복제'는 Passive로 매핑한다. **'C' 409건은 전부 ETN**(ETN에 ETF 전략코드 미적용)이라 ETF 필터 후 자동 소거된다."@ko .

fp:Strategy_Passive a fp:ManagementStrategy ; rdfs:label "패시브"@ko, "Passive"@en ;
    skos:altLabel "실물복제"@ko, "합성복제"@ko .
fp:Strategy_Active  a fp:ManagementStrategy ; rdfs:label "액티브"@ko, "Active"@en .

fp:hasManagementStrategy a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( fp:ETF fp:PublicFund ) ] ;
    rdfs:range fp:ManagementStrategy ;
    rdfs:label "운용전략"@ko, "has management strategy"@en ;
    rdfs:comment "상품 → 패시브/액티브 개체. 국내ETF는 cu_strtegy에서, 해외ETF는 cu_index_repl_mthd 결측 여부(결측 58.2% = 액티브·비추종)에서 추정한다."@ko ;
    fp:sourceTable "PREF01N001", "derived:etf_kr_enriched" ;
    fp:sourceColumn "cu_strtegy", "derived:etf_kr_enriched.replication" .

fp:Brand a owl:Class ;
    rdfs:label "ETF 브랜드"@ko, "ETF Brand"@en ;
    rdfs:comment "KODEX·TIGER·RISE·ACE·PLUS·SOL·KIWOOM 등 상품 브랜드. 'TIGER ETF' 같은 자연어 질의의 대응축이며 pd_abrv_nm의 선두 토큰이 유일 소재다. ETF는 영문 브랜드, ETN은 한글 증권사명으로 배타적으로 갈린다."@ko .

fp:Leverage_Standard   a fp:LeverageType ; rdfs:label "일반(1배)"@ko, "Standard"@en .
fp:Leverage_2X         a fp:LeverageType ; rdfs:label "레버리지 2배"@ko, "Leveraged2X"@en .
fp:Leverage_3X         a fp:LeverageType ; rdfs:label "레버리지 3배"@ko, "Leveraged3X"@en .
fp:Leverage_Inverse1X  a fp:LeverageType ; rdfs:label "인버스 1배"@ko, "Inverse1X"@en .
fp:Leverage_Inverse2X  a fp:LeverageType ; rdfs:label "인버스 2배"@ko, "Inverse2X"@en .
fp:Leverage_Inverse3X  a fp:LeverageType ; rdfs:label "인버스 3배"@ko, "Inverse3X"@en .

fp:Scope_MarketRepresentative a fp:UnderlyingScope ; rdfs:label "시장대표"@ko, "MarketRepresentative"@en .
fp:Scope_SectorTheme          a fp:UnderlyingScope ; rdfs:label "섹터·테마"@ko, "SectorTheme"@en .
fp:Scope_SingleStock          a fp:UnderlyingScope ; rdfs:label "개별종목"@ko, "SingleStock"@en .

fp:Distribution_Distributing a fp:DistributionType ; rdfs:label "분배형"@ko, "Distributing"@en .
fp:Distribution_TotalReturn  a fp:DistributionType ; rdfs:label "토탈리턴(TR)"@ko, "TotalReturn"@en .

################################################################################
# 2. 국내 ETF 관계 (owl:ObjectProperty)
################################################################################

fp:hasLeverageType a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( fp:ETF fp:ETN ) ] ;
    rdfs:range fp:LeverageType ;
    rdfs:label "레버리지 유형"@ko, "has leverage type"@en ;
    rdfs:comment "상품 → 레버리지 유형 개체. cu_lev_fector 배수값(1/2/-2/-1/3/-3/-0.5/1.5/-1.5)에서 매핑한다."@ko ;
    fp:sourceTable "PREF01N001" ; fp:sourceColumn "cu_lev_fector" .

fp:hasUnderlyingScope a owl:ObjectProperty ;
    rdfs:domain fp:ETF ;
    rdfs:range fp:UnderlyingScope ;
    rdfs:label "기초자산 범위"@ko, "has underlying scope"@en ;
    rdfs:comment "ETF → 기초자산 범위 개체. **현재 데이터로 값을 채울 수 없다**(기초지수 95.2% 결측, 섹터명 전량 결측). 간이투자설명서 수집 이후 부여한다."@ko .

fp:hasDistributionType a owl:ObjectProperty ;
    rdfs:domain fp:ETF ;
    rdfs:range fp:DistributionType ;
    rdfs:label "분배 유형"@ko, "has distribution type"@en ;
    rdfs:comment "ETF → 분배 유형 개체. **배당 컬럼 전량 무효**라 상품명 'TR' 토큰 추정 외에는 근거가 없다. '월배당 ETF' 질의는 답변 불가다."@ko .

fp:hasBrand a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( fp:ETF fp:ETN ) ] ;
    rdfs:range fp:Brand ;
    rdfs:label "브랜드"@ko, "has brand"@en ;
    rdfs:comment "상품 → 브랜드 개체. pd_abrv_nm 선두 토큰에서 파생하며, 운용사 문자열 오염 55건(운용사 자리에 상품 전체 명칭이 들어간 행)을 교차검증·복구하는 수단이기도 하다."@ko ;
    fp:sourceTable "PREF01N001" ; fp:sourceColumn "pd_abrv_nm" .

################################################################################
# 3. 국내 ETF 데이터 속성
#    필수-식별 4 / 필수-조건 21 / 필수-관계 2 등급 컬럼만 싣는다.
#    공통 속성(fp:netAssets·fp:expenseRatio·fp:return*·fp:listingDate·fp:onSale)은
#    fp-common에 선언되어 있으므로 여기서 중복 선언하지 않는다.
################################################################################

fp:internalCode a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( fp:ETF fp:ETN ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "사내 단축코드"@ko, "internal short code"@en ;
    rdfs:comment "미래에셋 사내 코드(A305080·Q760014 형식). 앞 한 글자를 뗀 값이 LSEG 메타 조인키(lseg_key)라 외부 보완 데이터 결합의 실무 키다."@ko ;
    fp:sourceTable "PREF01N001" ; fp:sourceColumn "pd_itm_no_ma" .

fp:productGroup a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( fp:ETF fp:ETN ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "상품군 종류"@ko, "product group"@en ;
    rdfs:comment "ETF / ETN 판별의 **유일 신뢰축**. 이 값으로 fp:ETF·fp:ETN 클래스를 확정한 뒤 모든 집계를 수행한다."@ko ;
    fp:sourceTable "PREF01N001", "PREF02N001" ; fp:sourceColumn "pd_grp_no" .

fp:leverageFactor a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( fp:ETF fp:ETN ) ] ;
    rdfs:range xsd:decimal ;
    rdfs:label "레버리지 배수"@ko, "leverage factor"@en ;
    rdfs:comment "지수 대비 배수. **음수는 인버스**를 뜻한다(-2 = 인버스 2배). 해외ETF는 이 컬럼이 전량 결측이라 국내ETF에서만 정형 필터가 가능하다."@ko ;
    fp:sourceTable "PREF01N001" ; fp:sourceColumn "cu_lev_fector" .

fp:hedgeType a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "환헤지 유형"@ko, "hedge type"@en ;
    rdfs:comment "환헤지·환노출 구분(LSEG 보강). 원본에는 대응 컬럼이 없어 외부 보완값이며 fp:sourceId로 출처를 함께 표시한다."@ko ;
    fp:sourceTable "derived:etf_kr_enriched" ; fp:sourceColumn "derived:etf_kr_enriched.hedge_type" .

fp:baseMarket a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "기초 시장"@ko, "base market"@en ;
    rdfs:comment "기초자산이 속한 시장(국내·해외 등, LSEG 보강). 국내ETF 기초지수가 95.2% 결측인 상황의 대체 축이다."@ko ;
    fp:sourceTable "derived:etf_kr_enriched" ; fp:sourceColumn "derived:etf_kr_enriched.base_market" .

fp:baseAsset a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "기초 자산"@ko, "base asset"@en ;
    rdfs:comment "기초자산 종류(LSEG 보강). wu_inv_ast_type과 교차검증용으로 함께 제시한다."@ko ;
    fp:sourceTable "derived:etf_kr_enriched" ; fp:sourceColumn "derived:etf_kr_enriched.base_asset" .

fp:delistingDate a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( fp:ETF fp:ETN ) ] ;
    rdfs:range xsd:date ;
    rdfs:label "거래종료일"@ko, "delisting date"@en ;
    rdfs:comment "상장폐지·만기일. **sentinel '99991231' 1,521건은 '만기 없음/존속'을 뜻하므로 날짜로 파싱하지 않는다.** ETN 만기 구분에 유효하다."@ko ;
    fp:sourceTable "PREF01N001" ; fp:sourceColumn "pd_lste_dt" .

fp:tradingSuspended a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( fp:ETF fp:ETN ) ] ;
    rdfs:range xsd:boolean ;
    rdfs:label "거래정지 여부"@ko, "trading suspended"@en ;
    rdfs:comment "1=정지(72건). 매수 가능 상품 조건검색에서 제외 필터로 쓴다. 해외ETF는 전량 0이라 이 축이 없다."@ko ;
    fp:sourceTable "PREF01N001" ; fp:sourceColumn "pd_tr_yn" .

fp:pensionTradable a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( fp:ETF fp:ETN ) ] ;
    rdfs:range xsd:boolean ;
    rdfs:label "연금계좌 거래 가능"@ko, "pension tradable"@en ;
    rdfs:comment "연금저축·IRP 계좌 매매 가능 여부(Y 1,002 / N 732). '연금저축으로 살 수 있는' 질의의 직접 축이다."@ko ;
    fp:sourceTable "PREF01N001" ; fp:sourceColumn "pd_pen_tr_yn" .

fp:pensionRiskCategory a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( fp:ETF fp:ETN ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "연금 위험자산 구분"@ko, "pension risk category"@en ;
    rdfs:comment "연금계좌 편입 시 위험자산 한도(70%) 판정 구분(위험자산 788 / 안전자산 214). **'N' 732건은 구분값이 아니라 '연금거래 불가'**이며 fp:pensionTradable=false와 정확히 대응하므로 분류값으로 해석하면 안 된다."@ko ;
    fp:sourceTable "PREF01N001" ; fp:sourceColumn "pd_pen_risk_nm" .

fp:coreProduct a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:boolean ;
    rdfs:label "핵심상품 선정 여부"@ko, "core product"@en ;
    rdfs:comment "당사 선정 핵심 ETF(Y 88건, 전부 ETF). '추천 ETF' 질의의 유일한 내부 근거다. 해외ETF는 Y가 0건이라 같은 필터를 적용할 수 없다."@ko ;
    fp:sourceTable "PREF01N001" ; fp:sourceColumn "wu_core_yn" .

fp:brandName a owl:DatatypeProperty ;
    rdfs:domain fp:Brand ; rdfs:range xsd:string ;
    rdfs:label "브랜드명"@ko, "brand name"@en ;
    rdfs:comment "브랜드 개체의 명칭. pd_abrv_nm 선두 토큰에서 파생한다."@ko ;
    fp:sourceTable "derived:etf_kr_brand" ; fp:sourceColumn "derived:etf_kr_brand.brand" .

################################################################################
# 4. 테마 개체 — 176종
#
#   원천: data/relations/etf_theme.csv (LSEG themes, 국내ETF 1,099종 × 176테마)
#   fp:relatedToTheme(fp-common)의 range 개체다.
#
#   **as_of 공란 주의**: 원천 관계 테이블의 as_of 컬럼이 비어 있다. LSEG 수집 시점이
#   확인되지 않아 추정 날짜를 채워 넣지 않았다(근거 표시에서 거짓 기준일이 되기 때문).
#   따라서 '특정 기간에 새로 연결된 테마' 류 시그널 질의는 이 관계만으로 답할 수 없다.
#
#   테마명이 슬래시로 결합된 경우('우주항공/방산', '미디어/엔터')는 원표기를 그대로
#   유지한다. '우주' 단독 테마는 존재하지 않으므로 부분 문자열 검색으로 새 테마를
#   만들어내면 안 된다.
#
#   개체 IRI는 테마명을 그대로 쓰되 공백만 '_'로 치환했다(추적성 유지).
#   본 절은 label만 부여해 간결하게 유지한다.
################################################################################

<http://mafest.ai/product#Theme_2차전지> a fp:Theme ; rdfs:label "2차전지"@ko ; fp:themeName "2차전지" .
