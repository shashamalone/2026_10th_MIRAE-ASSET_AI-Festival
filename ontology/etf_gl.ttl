@prefix fp:      <http://mafest.ai/product#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

fp:inceptionDate a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( fp:GlobalETF fp:GlobalETN ) ] ;
    rdfs:range xsd:date ;
    rdfs:label "설정일"@ko, "inception date"@en ;
    rdfs:comment "해외 ETF/ETN의 설정일. PREF02 pd_lstg_dt는 공식 정의상 상장일이 아니므로 listingDate로 노출하지 않는다."@ko ;
    fp:sourceTable "PREF02N001" ; fp:sourceColumn "pd_lstg_dt" .

################################################################################
# fp-etf-gl — 해외 ETF·ETN (PREF02N001, 6,037종 = ETF 5,972 / ETN 65)
#
# Q35("VOO가 직접 발행한 회사채") 판정의 주 무대
#   VOO는 이 도메인의 fp:ETF 개체다. fp:issuedBy는 fp-common에서
#   rdfs:domain fp:Bond로 한정되어 있고 fp:ETF owl:disjointWith fp:Bond이므로,
#   VOO를 fp:issuedBy의 주어로 놓는 질의는 **도메인 위반**이 되어 ABSTAIN된다.
#   데이터 측 교차 확인: 채권 마스터(PRBD01N001)에 'VOO' 문자열 0건.
#
# 식별자 주의 (매우 중요)
#   - URI 소재는 fp:productCode(pd_itm_no, 로이터 RIC, 중복 0건)다.
#   - **fp:isinCode는 중복 50종이 있어 유일키로 쓰면 안 된다.** 티커 변경 후 구
#     레코드가 남은 잔재이며 fp:lipperId도 동일하게 50건 중복한다.
#     ISIN·Lipper ID는 외부 조인 속성으로만 쓴다.
#   - fp:cikCode는 상품 단위로 유일하지 않을 수 있는 트러스트 단위 코드다.
#     개별 ETF를 특정하려면 SEC Series ID가 추가로 필요하며, 이것이 해외
#     편입종목(N-PORT) 확보의 실제 병목이다.
#
# 데이터 실태 (온톨로지에서 뺀 컬럼의 근거)
#   - 주최측에는 1년 수익률 축이 없다. LSEG get_history의 조정가격 또는
#     total-return 계열을 권한상 확보한 경우에만 1년 수익률을 계산한다.
#     단순 종가 대체는 금지하고 실패는 coverage unavailable로 남긴다.
#   - 괴리율 du_diff_rt: 유효 3건(그중 1건은 명백한 이상치) → **제외**
#   - 레버리지 배수 cu_lev_fector: 전량 결측 → **제외**. 인버스는
#     fp:isInverse(Y 171건)가 유일 정형축이고, 배수는 상품명 파싱으로만 추정된다.
#   - 판매·거래정지·핵심상품: pd_sale_yn 전량 1, pd_tr_yn 전량 0, wu_core_yn은
#     N만 존재 → **필터로 기능하지 못하므로 제외.** 국내ETF에 있는 판매·추천
#     필터를 해외에 적용할 수 없다.
#   - 완전 중복 컬럼(pd_itm_no_ma ≡ pd_itm_no, cu_etn_yn ≡ pd_grp_no='ETN',
#     ru_mkt_volume ≡ du_vol_1d) → **중복 적재하지 않음**
#   - 시세성 컬럼(du_clpr·du_opr·du_hpr·du_bpr·du_last_nav 등) → **제외**
#
# release/cutoff 2026-08-24, 상품·NAV 갱신은 최대 2026-08-22다.
# 개별 관측 기준일은 source/as_of와 함께 쓴다.
#
# 주최측 axis 라벨: 해외ETF axis_sample에는 axis_* 컬럼이 제공되지 않았다.
#   국내ETF 축(자산군·지역·전략·복제방식·레버리지)을 준용하되, 레버리지 축은
#   위와 같이 원본 결측이라 값을 채울 수 없다.
################################################################################

<http://mafest.ai/ontology/fp-etf-gl> a owl:Ontology ;
    owl:imports <http://mafest.ai/ontology/fp-common> ;
    rdfs:label "해외 ETF 온톨로지"@ko, "Global ETF Ontology"@en ;
    rdfs:comment "해외(미국 상장) ETF·ETN 마스터(PREF02N001) 기반 스키마. 외부 조인키(ISIN·CIK·Lipper), 복제방식, 서술형 투자전략 텍스트, 거래소 축을 정의한다."@ko ;
    dcterms:source "pref02n001_data.xlsx, pref02n001_schema.xlsx (2026-08-24 배포)" .

################################################################################
# 1. 외부 조인키 — 편입종목·기업관계 확보의 열쇠
################################################################################

fp:isinCode a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( fp:ETF fp:ETN ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "ISIN 코드"@ko, "ISIN code"@en ;
    rdfs:comment "국제증권식별번호. 외부 holdings 조인의 표준키다. **중복 50종이 존재하므로 유일키(owl:InverseFunctionalProperty)로 선언하지 않는다.** 티커 변경 후 구 레코드가 남은 잔재이며, 상품 URI는 반드시 fp:productCode(pd_itm_no)로 구성한다."@ko ;
    fp:sourceTable "PREF02N001" ; fp:sourceColumn "pd_isin_cd" .

fp:cikCode a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( fp:ETF fp:ETN ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "SEC CIK 코드"@ko, "SEC CIK code"@en ;
    rdfs:comment "SEC EDGAR 등록번호. N-PORT 구성종목 취득 경로지만 트러스트 단위 코드라 이것만으로 개별 ETF를 특정하지 않고 Series ID 등 공식 식별자를 함께 검증한다."@ko ;
    fp:sourceTable "PREF02N001" ; fp:sourceColumn "pd_us_cik" .

fp:lipperId a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( fp:ETF fp:ETN ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "Lipper 펀드 ID"@ko, "Lipper fund ID"@en ;
    rdfs:comment "LSEG Lipper 식별자. 외부 펀드 DB 조인키이며 ISIN 중복 50종과 동일 종목군에서 50건 중복한다. 유일키로 쓰지 않는다."@ko ;
    fp:sourceTable "PREF02N001" ; fp:sourceColumn "pd_lipper_id" .

fp:ticker a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( fp:ETF fp:ETN ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "티커"@ko, "ticker"@en ;
    rdfs:comment "미국 상장 티커(VOO·SPY·BND 등). 자연어 질의의 주요 식별 표현이지만 중복 가능성이 있어 단독 URI로 쓰지 않고 RIC·ISIN 등과 함께 확인한다."@ko ;
    fp:sourceTable "PREF02N001" ; fp:sourceColumn "pd_abrv_nm" .

################################################################################
# 2. 해외 ETF 고유 속성
################################################################################

fp:exchangeCode a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( fp:ETF fp:ETN ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "상장 거래소 코드"@ko, "exchange code"@en ;
    rdfs:comment "거래소 시장 원문 코드. 공식 코드 이름 대응이 없으면 의미를 추정하거나 거래소 필터에 사용하지 않는다."@ko ;
    fp:sourceTable "PREF02N001" ; fp:sourceColumn "pd_exg_mkt_cd" .

fp:isInverse a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:boolean ;
    rdfs:label "인버스·숏 여부"@ko, "is inverse"@en ;
    rdfs:comment "인버스·숏 상품 플래그(Y 171건, 결측=일반형). cu_lev_fector가 전량 결측이라 **해외ETF 인버스 질의의 유일한 정형축**이다. 배수(2X·3X)는 상품명·전략 텍스트 파싱으로만 추정된다."@ko ;
    fp:sourceTable "PREF02N001" ; fp:sourceColumn "cu_inverse_short_yn" .

fp:strategyText a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "투자전략 원문"@ko, "strategy text"@en ;
    rdfs:comment "enum이 아니라 서술형 투자전략 문단이다. 국내ETF의 동명 코드 컬럼과 이름만 같고 성격이 다르므로 정형 필터로 쓰지 않고 문서 청크·벡터 검색의 근거 텍스트로 소비한다."@ko ;
    fp:sourceTable "PREF02N001" ; fp:sourceColumn "cu_strtegy" .

fp:indexTrackingUnavailable a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:boolean ;
    rdfs:label "기초지수 미제공 여부"@ko, "index unavailable"@en ;
    rdfs:comment "cu_base_index가 'Index is not provided by Management Company' 또는 'Index is not available on Lipper Database' 계열 sentinel이면 true다. sentinel을 NULL로 처리해 '기초지수 미제공'과 '비추종'을 구분한다."@ko ;
    fp:sourceTable "PREF02N001" ; fp:sourceColumn "cu_base_index" .

fp:navBaseDate a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:date ;
    rdfs:label "NAV 기준일"@ko, "NAV base date"@en ;
    rdfs:comment "NAV 산출 기준일. 종가 기준일과 같다고 가정하지 않으며 가격과 NAV를 함께 제시할 때 각 원천 기준일을 별도로 표기한다."@ko ;
    fp:sourceTable "PREF02N001" ; fp:sourceColumn "du_nav_base_dt" .

fp:closePriceBaseDate a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( fp:ETF fp:ETN ) ] ;
    rdfs:range xsd:date ;
    rdfs:label "종가 기준일"@ko, "close price base date"@en ;
    rdfs:comment "종가 기준일. 86종으로 분산되어 stale 종목이 섞여 있으므로 '현재 가격' 질의에서 이 값을 반드시 함께 제시한다."@ko ;
    fp:sourceTable "PREF02N001" ; fp:sourceColumn "du_clpr_base_dt" .
